# --- API server ---
PORT=3000

# --- Vexa.ai (primary engine) ---
# Get a key from https://dashboard.vexa.ai
VEXA_API_KEY=vx_sk_xxx
VEXA_BASE_URL=https://api.cloud.vexa.ai

# --- Fallback (Playwright browser automation) ---
FALLBACK_ENABLED=true
# Run the browser with a visible window. Google Meet often blocks headless
# Chromium, so keep this false on a machine with a display, or use xvfb.
HEADLESS=false
# Persistent Chromium profile dir — keeps the bot logged into Google between runs.
GOOGLE_SESSION_DIR=./data/google-profile
# Display name the bot uses if it has to enter one before joining.
BOT_DISPLAY_NAME=Meeting Bot

# --- Bot behaviour ---
JOIN_TIMEOUT_MS=60000
MAX_RETRIES=2
