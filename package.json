  },
  "homepage": "https://github.com/renfrrd-ai/Meeting-bot-central-agent#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
