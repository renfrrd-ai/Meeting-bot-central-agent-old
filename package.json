{
  "name": "meeting-bot-central-agent",
  "version": "1.0.0",
  "description": "A meeting bot that joins a google meet call using Vexa.ai",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "login": "tsx src/scripts/login.ts",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renfrrd-ai/Meeting-bot-central-agent.git"
  },
